# Server
PORT=8787
DATABASE_PATH=data/waypoint.db
# Set to 1 only when running production mode over plain HTTP locally (disables Secure cookies).
INSECURE_COOKIES=

# Required before enabling any OAuth integration: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Canvas LMS (per institution; issued by the school's Canvas admin as a Developer Key)
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=

# Claude AI (optional): study sets, the skin product finder and the build planner. If set, every
# account on this server can use them without adding its own key; usage is billed to this key.
# Leave empty to let each user add a key in Settings → Connections. Never commit the real .env file.
ANTHROPIC_API_KEY=

# Google Gemini (optional), used by the skin product finder and build planner when there is no
# Anthropic key. Free tier from aistudio.google.com: limited requests, and Google may use what is
# sent (including photos) to improve its products. Study sets still need an Anthropic key.
GEMINI_API_KEY=

# Reminders (Web Push). A contact address push services can reach if something goes wrong.
VAPID_SUBJECT=mailto:you@example.com
