# Server
PORT=8787
DATABASE_PATH=data/waypoint.db
# Set to 1 only when running production mode over plain HTTP locally (disables Secure cookies).
INSECURE_COOKIES=

# Required before enabling any OAuth integration: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Canvas LMS (per institution; issued by the school's Canvas admin as a Developer Key)
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=

# AI study sets (optional). If set, every account on this server can generate study sets
# without adding its own key. Leave empty to let each user add a key in Settings → Connections.
ANTHROPIC_API_KEY=
