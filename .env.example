# Server
PORT=8787
DATABASE_PATH=data/waypoint.db
# Set to 1 only when running production mode over plain HTTP locally (disables Secure cookies).
INSECURE_COOKIES=

# Required before enabling any OAuth integration: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Canvas LMS (per institution; issued by the school's Canvas admin as a Developer Key)
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
CANVAS_REDIRECT_URI=

# Claude AI (optional): study sets, the skin product finder and the build planner. If set, every
# account on this server can use them without adding its own key; usage is billed to this key.
# Leave empty to let each user add a key in Settings → Connections. Never commit the real .env file.
ANTHROPIC_API_KEY=

# Google Gemini (optional), used by the skin product finder and build planner when there is no
# Anthropic key. Free tier from aistudio.google.com: limited requests, and Google may use what is
# sent (including photos) to improve its products. Study sets still need an Anthropic key.
GEMINI_API_KEY=

# Compass (the AI chat): questions per person per day. Each answer can include up to
# 5 web searches, so this keeps your AI bill predictable. Default 40.
COACH_DAILY_LIMIT=

# Optional: a YouTube Data API key for everyone's Compass video research (free from
# Google Cloud Console). Each person can also add their own in Settings → Connections.
YOUTUBE_API_KEY=

# Reminders (Web Push). A contact address push services can reach if something goes wrong.
VAPID_SUBJECT=mailto:you@example.com

# --- Online (production) settings; see docs/DEPLOY.md ---
# The public address, used in password-reset emails. Never taken from request headers.
APP_URL=
# Set to 1 behind a proxy such as Render, so rate limits see the real visitor address.
TRUST_PROXY=
# If set, people need this code to sign up (recommended when ANTHROPIC_API_KEY is set).
SIGNUP_CODE=

# Password reset by email (optional; recovery codes work without it).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your address, SMTP_PASS=a Google app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
