{
  "name": "waypoint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Waypoint — a personal planning system that turns goals, schedule and resources into a realistic daily plan.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --production",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api:watch": "tsx watch --clear-screen=false server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@google/genai": "^2.32.0",
    "@hono/node-server": "^2.1.8",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.18",
    "lucide-react": "^1.73.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
